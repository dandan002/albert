[Unit]
Description=albert: vol-study Kalshi L2 recorder (complete game, half, ladder and weather events; public data)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/albert
Environment=PYTHON=/home/ubuntu/albert/.venv/bin/python
Environment=RECORD_CMD=record-vol
ExecStart=/home/ubuntu/albert/deploy/record-loop.sh --ladder-interval-ms 1000
Restart=always
RestartSec=60
KillMode=control-group
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
